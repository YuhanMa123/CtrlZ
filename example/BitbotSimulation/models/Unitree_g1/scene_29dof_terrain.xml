<mujoco model="g1_29dof terrain scene">
      <include file="g1_29dof_rev_1_0.xml" />

      <statistic center="0 -7.5 0.8" extent="9.0" />

      <option timestep="0.002" integrator="RK4">
            <flag sensornoise="enable" />
      </option>

      <visual>
            <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0" />
            <rgba haze="0.15 0.25 0.35 1" />
            <global azimuth="-130" elevation="-20" />
      </visual>

      <asset>
            <texture type="skybox"
                  builtin="gradient"
                  rgb1="0.3 0.5 0.7"
                  rgb2="0 0 0"
                  width="512"
                  height="3072" />
            <texture type="2d"
                  name="terrain_groundplane"
                  builtin="checker"
                  mark="edge"
                  rgb1="0.2 0.3 0.4"
                  rgb2="0.1 0.2 0.3"
                  markrgb="0.8 0.8 0.8"
                  width="300"
                  height="300" />
            <material name="terrain_groundplane"
                  texture="terrain_groundplane"
                  texuniform="true"
                  texrepeat="8 8"
                  reflectance="0.2" />
            <material name="terrain_ground_mat" rgba="0.28 0.33 0.30 1" />
            <material name="terrain_slope_mat" rgba="0.42 0.35 0.24 1" />
            <material name="terrain_stair_mat" rgba="0.36 0.36 0.42 1" />
            <material name="terrain_trench_mat" rgba="0.18 0.18 0.20 1" />
      </asset>

      <default>
            <default class="terrain_contact">
                  <geom type="box"
                        contype="1"
                        conaffinity="1"
                        condim="4"
                        friction="1.2 0.08 0.02"
                        solref="0.005 1"
                        solimp="0.95 0.99 0.001"
                        group="0" />
            </default>
      </default>

      <worldbody>
            <light pos="0 -7.5 3.0" dir="0 0 -1" directional="true" />
            <geom name="floor"
                  type="plane"
                  size="0 0 0.05"
                  material="terrain_groundplane" />

            <!-- Terrain parameter interface:
         1. Slope steepness: edit terrain_slope_up / terrain_slope_down euler.
         2. Slope length: edit the x half-size of terrain_slope_* geoms.
         3. Stair height/depth: edit each terrain_stair_* z/x pos and size.
         4. Trench width/depth: edit trench_left/right x and trench_bottom z.
         5. All pieces are physical collision geoms for contact testing. -->

            <!-- Rotate the terrain strip so it extends along the robot facing direction.
                 The robot root is yawed by -1.57 rad in g1_29dof_rev_1_0.xml. -->
            <body name="terrain_course" pos="0 0 0" euler="0 0 -1.57">
                  <geom name="terrain_slope_up"
                        class="terrain_contact"
                        material="terrain_slope_mat"
                        pos="3.20 0 0.076"
                        size="0.80 0.5 0.05"
                        euler="0 -0.155 0" />

                  <geom name="terrain_upper_landing"
                        class="terrain_contact"
                        material="terrain_ground_mat"
                        pos="4.30 0 0.125"
                        size="0.30 0.5 0.125" />

                  <geom name="terrain_stair_up_1"
                        class="terrain_contact"
                        material="terrain_stair_mat"
                        pos="4.75 0 0.175"
                        size="0.15 0.5 0.175" />
                  <geom name="terrain_stair_up_2"
                        class="terrain_contact"
                        material="terrain_stair_mat"
                        pos="5.05 0 0.225"
                        size="0.15 0.5 0.225" />
                  <geom name="terrain_stair_up_3"
                        class="terrain_contact"
                        material="terrain_stair_mat"
                        pos="5.35 0 0.275"
                        size="0.15 0.5 0.275" />
                  <geom name="terrain_stair_up_4"
                        class="terrain_contact"
                        material="terrain_stair_mat"
                        pos="5.65 0 0.325"
                        size="0.15 0.5 0.325" />

                  <geom name="terrain_top_landing"
                        class="terrain_contact"
                        material="terrain_ground_mat"
                        pos="6.25 0 0.325"
                        size="0.30 0.5 0.325" />

                  <geom name="terrain_stair_down_1"
                        class="terrain_contact"
                        material="terrain_stair_mat"
                        pos="6.85 0 0.275"
                        size="0.15 0.5 0.275" />
                  <geom name="terrain_stair_down_2"
                        class="terrain_contact"
                        material="terrain_stair_mat"
                        pos="7.15 0 0.225"
                        size="0.15 0.5 0.225" />
                  <geom name="terrain_stair_down_3"
                        class="terrain_contact"
                        material="terrain_stair_mat"
                        pos="7.45 0 0.175"
                        size="0.15 0.5 0.175" />
                  <geom name="terrain_stair_down_4"
                        class="terrain_contact"
                        material="terrain_stair_mat"
                        pos="7.75 0 0.125"
                        size="0.15 0.5 0.125" />

                  <geom name="terrain_lower_landing"
                        class="terrain_contact"
                        material="terrain_ground_mat"
                        pos="8.15 0 0.125"
                        size="0.25 0.5 0.125" />

                  <geom name="terrain_slope_down"
                        class="terrain_contact"
                        material="terrain_slope_mat"
                        pos="9.20 0 0.076"
                        size="0.80 0.5 0.05"
                        euler="0 0.155 0" />
            </body>

      </worldbody>
</mujoco>